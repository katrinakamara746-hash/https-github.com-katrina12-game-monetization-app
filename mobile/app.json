    "jest": "^29.7.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.2.0",
    "eslint": "^8.54.0",
    "react-native-cli": "^2.0.0",
    "react-test-renderer": "^18.2.0"
